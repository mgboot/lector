# Azure OpenAI endpoint (e.g. https://your-resource.cognitiveservices.azure.com)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Model deployment name in Azure OpenAI
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=gpt-4.1

# Embedding model for textbook search
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024

# Azure AI Content Understanding endpoint (OCR fallback — only needed for re-indexing)
# AZURE_AI_ENDPOINT=https://your-ai-services-resource.services.ai.azure.com
